<%= knowledge_tabs %>

<h1>Player</h1>
<p class="meta">Score sheet, inventory, and equipment — read live from <code>knowledge.sqlite3</code> (player_map_plan.md Part 1). Score refreshes on every new-room survey; inventory and equipment on the agent's first survey of a run, then after every get/drop/equip.</p>

<% if !knowledge_store.enabled? %>
  <p class="empty">
    No <code><%= settings.knowledge_db %></code> yet. It's created the first time the agent runs with a <code>mud:</code> MCP server configured.
  </p>
<% elsif @player.nil? %>
  <p class="empty">No player state recorded yet.</p>
<% else %>
  <div class="statstrip">
    <div class="statstrip-head">
      <span class="statstrip-model">Score</span>
      <span class="statstrip-cost">as of <%= format_time(@player["updated_at"]) %></span>
    </div>
    <div class="statstrip-total">
      <% if @player["hp"] %><%= @player["hp"] %><%= "/#{@player["max_hp"]}" if @player["max_hp"] %>hp &middot; <% end %>
      <% if @player["mana"] %><%= @player["mana"] %><%= "/#{@player["max_mana"]}" if @player["max_mana"] %>mana &middot; <% end %>
      <% if @player["move"] %><%= @player["move"] %><%= "/#{@player["max_move"]}" if @player["max_move"] %>mv &middot; <% end %>
      <% if @player["level"] %>lvl <%= @player["level"] %> &middot; <% end %>
      <% if @player["gold"] %><%= @player["gold"] %> gold &middot; <% end %>
      <%= @player["position"] || "position unknown" %>
      <% if @player["current_room_id"] %>
        &middot; in <a href="/knowledge/rooms/<%= @player["current_room_id"] %>"><%= @rooms.find { |r| r["id"] == @player["current_room_id"] }&.dig("name") || "room #{@player["current_room_id"]}" %></a>
      <% end %>
    </div>
  </div>

  <div class="kv-strip">
    <div class="kv"><span class="kv-num"><%= @player["age"] || "&mdash;" %></span><span class="kv-label">age</span></div>
    <div class="kv"><span class="kv-num"><%= @player["armor_class"] || "&mdash;" %></span><span class="kv-label">armor class</span></div>
    <div class="kv"><span class="kv-num"><%= @player["alignment"] || "&mdash;" %></span><span class="kv-label">alignment</span></div>
    <div class="kv"><span class="kv-num"><%= @player["exp"] || 0 %><%= "/#{@player["exp_to_next_level"]}" if @player["exp_to_next_level"] %></span><span class="kv-label">exp to next level</span></div>
    <div class="kv"><span class="kv-num"><%= @player["quest_points"] || 0 %></span><span class="kv-label">quest points</span></div>
  </div>

  <h2>Inventory</h2>
  <% if @inventory.empty? %>
    <p class="empty">Nothing carried (or the agent hasn't surveyed a room yet this run).</p>
  <% else %>
    <table class="log-table">
      <thead>
        <tr>
          <th>Item</th>
          <th class="nowrap">Keyword</th>
          <th class="nowrap">Qty</th>
          <th class="nowrap">First seen</th>
          <th class="nowrap">Last seen</th>
        </tr>
      </thead>
      <tbody>
        <% @inventory.each do |item| %>
          <tr>
            <td><%= item["descr"] %></td>
            <td class="nowrap"><%= item["keyword"] || "&mdash;" %></td>
            <td class="nowrap"><%= item["quantity"] %></td>
            <td class="nowrap"><%= format_time(item["first_seen_at"]) %></td>
            <td class="nowrap"><%= format_time(item["last_seen_at"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2>Equipment</h2>
  <% if @equipment.empty? %>
    <p class="empty">Nothing worn (or the agent hasn't surveyed a room yet this run).</p>
  <% else %>
    <table class="log-table">
      <thead>
        <tr>
          <th class="nowrap">Slot</th>
          <th>Item</th>
          <th class="nowrap">Keyword</th>
          <th class="nowrap">Since</th>
        </tr>
      </thead>
      <tbody>
        <% @equipment.each do |item| %>
          <tr>
            <td class="nowrap"><%= item["slot"] %></td>
            <td><%= item["descr"] %></td>
            <td class="nowrap"><%= item["keyword"] || "&mdash;" %></td>
            <td class="nowrap"><%= format_time(item["first_seen_at"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
