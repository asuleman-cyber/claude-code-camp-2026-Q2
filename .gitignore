# Windows Zone.Identifier files (WSL download metadata)
*Zone.Identifier

# Environment / secrets
.env
.env.local

# Python virtualenv (shared at repo root across week1_baseline/python/* steps)
# WSL-backed; PowerShell forwards into it automatically (see $PROFILE / .envrc)
.venv/

# Python bytecode cache
__pycache__/

# Boukensha session logs, and the mud_manager manager/telnet logs mud_monitor reads
.boukensha/sessions/
.boukensha/manager/
.boukensha/telnet/

# Agent's SQLite room/entity memory (Phase D) — binary, changes every run
.boukensha/knowledge.sqlite3
.boukensha/knowledge.sqlite3-wal
.boukensha/knowledge.sqlite3-shm

# Change-capture journal (Phase E)
.boukensha/journal/

# Agent error log (Phase F)
.boukensha/error.log

# Claude Code local settings
.claude/

# Personal catch-up plan
docs/plans/week2_catchup_plan.md
